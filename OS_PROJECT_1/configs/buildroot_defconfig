#
# Buildroot Configuration for EdgeML Linux OS
# Target Architecture: aarch64 (ARM64)
# Target Platform: QEMU virt machine (Cortex-A57)
# Toolchain: GNU Glibc + GCC 13.x + C++17 + NPTL Threads
# ML Runtime: TensorFlow Lite 2.11.0 (ARM NEON SIMD / RUY)
# Root Filesystem: Read-Only SquashFS + In-Memory OverlayFS
#

# Architecture
BR2_aarch64=y
BR2_cortex_a57=y

# Linux Kernel Headers Version (Matches 6.12.x LTS Kernel)
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y

# Toolchain Options
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_VERSION_13_X=y
BR2_INSTALL_LIBSTDCPP=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_TOOLCHAIN_HAS_THREADS=y
BR2_TOOLCHAIN_HAS_THREADS_NPTL=y
BR2_SHARED_LIBS=y
BR2_GCC_ENABLE_LTO=y

# Optimization and Stripping
BR2_OPTIMIZE_3=y
BR2_STRIP_strip=y

# System Configuration
BR2_TARGET_GENERIC_HOSTNAME="edgeml-os"
BR2_TARGET_GENERIC_ISSUE="Welcome to EdgeML Linux OS (ARM64 QEMU Edge Inference)"
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_ROOTFS_OVERLAY="board/edgeml/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/edgeml/post-build.sh"

# Linux Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.27"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="configs/kernel_defconfig"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Core Target Packages
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_KMOD=y

# Machine Learning Target Package (TensorFlow Lite)
BR2_PACKAGE_TENSORFLOW_LITE=y

# Filesystem Target Images
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="120M"

# Host Utilities for Cross-Compilation
BR2_PACKAGE_HOST_CMAKE=y
BR2_PACKAGE_HOST_PKGCONF=y
BR2_PACKAGE_HOST_SQUASHFS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
