{
  "benchmark_suite": "EdgeML Linux OS Benchmarking Framework",
  "version": "1.0.0",
  "target_platform": {
    "architecture": "aarch64",
    "machine": "qemu_virt",
    "cpu": "cortex-a57",
    "vcpus": 4,
    "memory_mb": 1024,
    "storage_interface": "virtio-blk",
    "serial_console": "ttyAMA0"
  },
  "workload": {
    "framework": "TensorFlow Lite 2.11/2.14+",
    "acceleration": "ARM NEON SIMD (XNNPACK & RUY Micro-Kernels)",
    "model": "mobilenet_v2_quant.tflite",
    "quantization": "INT8 Full Integer",
    "input_resolution": [224, 224, 3],
    "output_classes": 1001,
    "warmup_iterations": 5,
    "benchmark_iterations": 50,
    "worker_threads": 4
  },
  "baseline_system": {
    "name": "Ubuntu 24.04 LTS ARM64 Server Minimal (Stock)",
    "kernel": "Linux 6.8.0-generic-arm64",
    "init_system": "systemd 255.4",
    "rootfs_type": "ext4",
    "package_manager": "dpkg/apt"
  },
  "custom_system": {
    "name": "EdgeML Linux OS (Custom Lightweight Distribution)",
    "kernel": "Linux 6.12.27 LTS Minimal ARM64",
    "init_system": "BusyBox 1.36.1 init",
    "rootfs_type": "SquashFS (Read-Only) + OverlayFS (tmpfs)",
    "package_manager": "None (Static Buildroot Inventory)"
  },
  "metrics": [
    "rootfs_uncompressed_mb",
    "rootfs_compressed_mb",
    "kernel_image_mb",
    "cold_boot_time_sec",
    "idle_memory_mb",
    "installed_package_count",
    "active_cpu_utilization_pct",
    "inference_latency_mean_ms",
    "inference_latency_median_ms",
    "inference_latency_p95_ms",
    "inference_throughput_fps"
  ]
}
