#!/bin/sh
# =============================================================================
# EdgeML Linux OS: Autonomous Edge AI Inference Service Daemon
# Init System: BusyBox SysV-style Init (/etc/init.d/S90edgeml)
# Controls: start | stop | restart | status
# =============================================================================

DAEMON_NAME="edgeml-service"
DAEMON_BIN="/usr/bin/edgeml-infer"
DEFAULT_IMAGE="/data/test.jpg"
DEFAULT_MODEL="/usr/share/models/mobilenet_v2_quant.tflite"
DEFAULT_LABELS="/usr/share/models/labels.txt"
PIDFILE="/var/run/edgeml.pid"
LOGFILE="/var/log/edgeml.log"
SERVICE_USER="edgeml"

# Ensure runtime directories exist in volatile storage
mkdir -p /var/run /var/log /data /tmp/results 2>/dev/null || true

start_daemon() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$DAEMON_NAME is already running (PID $(cat "$PIDFILE"))."
        return 0
    fi

    echo -n "Starting $DAEMON_NAME... "

    # Verify prerequisite binaries and model files
    if [ ! -x "$DAEMON_BIN" ]; then
        echo "FAILED (Executable $DAEMON_BIN not found or not executable)"
        return 1
    fi

    if [ ! -f "$DEFAULT_MODEL" ]; then
        echo "FAILED (Model file $DEFAULT_MODEL not found)"
        return 1
    fi

    # Supervised background inference runner loop with automatic restart policy
    (
        MAX_RESTARTS=5
        RESTART_COUNT=0
        while [ "$RESTART_COUNT" -lt "$MAX_RESTARTS" ]; do
            echo "[$(date -u +'%Y-%m-%dT%H:%M:%SZ')] Starting inference pass..." >> "$LOGFILE"
            
            # Execute inference with test image
            if [ -f "$DEFAULT_IMAGE" ]; then
                "$DAEMON_BIN" "$DEFAULT_IMAGE" "$DEFAULT_MODEL" "$DEFAULT_LABELS" >> "$LOGFILE" 2>&1
                EXIT_CODE=$?
            else
                echo "[$(date -u +'%Y-%m-%dT%H:%M:%SZ')] Test image $DEFAULT_IMAGE not found. Sleeping." >> "$LOGFILE"
                EXIT_CODE=0
            fi

            if [ "$EXIT_CODE" -ne 0 ]; then
                RESTART_COUNT=$((RESTART_COUNT + 1))
                echo "[$(date -u +'%Y-%m-%dT%H:%M:%SZ')] WARNING: Daemon crashed with code $EXIT_CODE (Failure $RESTART_COUNT/$MAX_RESTARTS)." >> "$LOGFILE"
                sleep 5
            else
                RESTART_COUNT=0
                # Normal operational sleep between periodic inference passes
                sleep 10
            fi
        done
        echo "[$(date -u +'%Y-%m-%dT%H:%M:%SZ')] CRITICAL: Max restart limit reached. Service paused to preserve system stability." >> "$LOGFILE"
    ) &

    DAEMON_PID=$!
    echo "$DAEMON_PID" > "$PIDFILE"
    echo "DONE (PID $DAEMON_PID)"
    return 0
}

stop_daemon() {
    if [ ! -f "$PIDFILE" ]; then
        echo "$DAEMON_NAME is not running."
        return 0
    fi

    PID=$(cat "$PIDFILE")
    echo -n "Stopping $DAEMON_NAME (PID $PID)... "

    if kill -0 "$PID" 2>/dev/null; then
        # Terminate runner and child processes
        kill "$PID" 2>/dev/null || true
        # Wait up to 5 seconds for graceful shutdown
        TIMEOUT=5
        while kill -0 "$PID" 2>/dev/null && [ "$TIMEOUT" -gt 0 ]; do
            sleep 1
            TIMEOUT=$((TIMEOUT - 1))
        done

        if kill -0 "$PID" 2>/dev/null; then
            kill -9 "$PID" 2>/dev/null || true
        fi
    fi

    rm -f "$PIDFILE"
    echo "DONE"
    return 0
}

status_daemon() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$DAEMON_NAME is running (PID $(cat "$PIDFILE"))."
        if [ -f "$LOGFILE" ]; then
            echo -e "\nRecent log entries ($LOGFILE):"
            tail -n 5 "$LOGFILE"
        fi
        return 0
    else
        echo "$DAEMON_NAME is stopped."
        return 3
    fi
}

case "$1" in
    start)
        start_daemon
        ;;
    stop)
        stop_daemon
        ;;
    restart)
        stop_daemon
        sleep 1
        start_daemon
        ;;
    status)
        status_daemon
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit $?
