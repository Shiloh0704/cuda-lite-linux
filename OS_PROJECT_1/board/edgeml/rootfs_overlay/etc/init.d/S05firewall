#!/bin/sh
# EdgeML Linux OS: Network Lockdown & Firewall Rules

case "$1" in
  start)
    echo "[SECURITY] Applying network port restrictions..."
    if command -v iptables >/dev/null 2>&1; then
        # Default policy: Drop incoming traffic, allow outgoing & loopback
        iptables -P INPUT DROP
        iptables -P FORWARD DROP
        iptables -P OUTPUT ACCEPT
        iptables -A INPUT -i lo -j ACCEPT
        iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
        echo "[SECURITY] iptables packet filtering rules active."
    else
        echo "[SECURITY] Note: Kernel headless profile has zero listening TCP/UDP ports."
    fi
    ;;
  stop)
    if command -v iptables >/dev/null 2>&1; then
        iptables -P INPUT ACCEPT
        iptables -P FORWARD ACCEPT
        iptables -P OUTPUT ACCEPT
        iptables -F
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
exit 0
