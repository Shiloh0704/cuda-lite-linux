
# =============================================================================
# CUDA-Lite Linux - Live Filesystem Configuration
# Debian 13 Trixie
#
# The SquashFS live root filesystem is mounted by live-boot.
# live-boot manages the writable overlay for the live session.
# Do not add a second OverlayFS mount for / here.
# =============================================================================

# Temporary storage
tmpfs   /tmp       tmpfs   nosuid,nodev,noatime,mode=1777,size=2G   0  0

# Temporary system logs
tmpfs   /var/log   tmpfs   nosuid,nodev,noatime,mode=0755,size=256M 0  0
