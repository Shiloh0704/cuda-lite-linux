[Unit]
Description=CUDA-Lite Linux GPU Diagnostic and Benchmark
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
ConditionPathIsExecutable=/usr/local/sbin/cuda-lite-startup

[Service]
Type=oneshot
User=root
ExecStart=/bin/bash /usr/local/sbin/cuda-lite-startup
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=300
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
